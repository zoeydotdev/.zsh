{
  "editor.fontFamily": "'GoMono Nerd Font', Consolas, 'Courier New', monospace",
  "editor.inlineSuggest.fontFamily": "'GoMono Nerd Font', Consolas, 'Courier New', monospace",
  "debug.console.fontFamily": "'GoMono Nerd Font', Consolas, 'Courier New', monospace",
  "terminal.integrated.fontFamily": "'GoMono Nerd Font', Consolas, 'Courier New', monospace",
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.viewSessions.enabled": false,
  "chat.titleBar.signIn.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "debug.console.fontSize": 14,
  "debug.toolBarLocation": "docked",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.accessibilitySupport": "off",
  "editor.autoIndent": "advanced",
  "editor.defaultFormatter": "EditorConfig.EditorConfig",
  "editor.detectIndentation": false,
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "trailing",
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "emmet.excludeLanguages": [
    "markdown",
    "elixir"
  ],
  "emmet.showAbbreviationSuggestions": false,
  "emmet.showExpandedAbbreviation": "never",
  "files.eol": "\n",
  "files.exclude": {
    "**/.elixir_ls": true
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.ignoreMissingGitWarning": true,
  "html.format.enable": false,
  "python.languageServer": "Default",
  "remote.SSH.remotePlatform": {
    "pihole": "linux"
  },
  "scm.inputFontFamily": "editor",
  "security.allowedUNCHosts": [
    "wsl$",
    "wsl.localhost"
  ],
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.defaultProfile.windows": "Debian (WSL)",
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.shell.windows": "C:\\Program Files\\WezTerm\\wezterm-gui.exe",
  "terminal.external.windowsExec": "C:\\Program Files\\WezTerm\\wezterm-gui.exe",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "window.commandCenter": true,
  "window.menuBarVisibility": "compact",
  "window.openFoldersInNewWindow": "on",
  "window.zoomLevel": 1,
  "workbench.colorTheme": "Dracula Theme Soft",
  "workbench.editor.closeOnFileDelete": true,
  "workbench.externalBrowser": "firefox",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter.notebook.ipynb"
  },
  "workbench.startupEditor": "none",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.tree.indent": 24,
  "files.associations": {
    "*.eex": "shellscript"
  },
  "[elixir]": {
    "editor.defaultFormatter": "JakeBecker.elixir-ls"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[csv]": {
    "editor.inlayHints.maximumLength": 0
  },
  "indentRainbow.colors": [
    "rgba(255,96,33,0.09)",
    "rgba(81,255,33,0.09)",
    "rgba(207,33,255,0.09)",
    "rgba(33,192,255,0.09)"
  ]
}
